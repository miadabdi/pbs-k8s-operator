# -*- mode: ruby -*-
# vi: set ft=ruby :

# Disposable test environment for developing pbs-operator against a real
# Proxmox Backup Server:
#   pbs       — PBS 4.2 (provisioned by provision/pbs.yml)
#   k8s-ctl1  — kubernetes control plane (kubespray)
#   k8s-node1 — kubernetes worker (kubespray)
# Host-only network uses the pre-existing vboxnet0 (192.168.56.1).
# Disks stay box-default (thin via vb.linked_clone).

Vagrant.configure("2") do |config|
  # One shared SSH key for the PBS playbook and kubespray
  # (generated by scripts/gen-keys.sh before `vagrant up`).
  config.vm.provision "shell", path: "provision/inject-key.sh"

  config.vm.define "pbs" do |vm|
    vm.vm.box = "bento/debian-13"
    vm.vm.hostname = "pbs"
    vm.vm.network "private_network", ip: "192.168.56.10"
    vm.vm.provider "virtualbox" do |vb|
      vb.linked_clone = true
      vb.memory = 4096
      vb.cpus = 2
    end
  end

  config.vm.define "k8s-ctl1" do |vm|
    vm.vm.box = "bento/ubuntu-24.04"
    vm.vm.hostname = "k8s-ctl1"
    vm.vm.network "private_network", ip: "192.168.56.11"
    vm.vm.provider "virtualbox" do |vb|
      vb.linked_clone = true
      # etcd + control plane fit in 4 GB; larger sizes OOM the host.
      vb.memory = 4096
      vb.cpus = 2
    end
  end

  config.vm.define "k8s-node1" do |vm|
    vm.vm.box = "bento/ubuntu-24.04"
    vm.vm.hostname = "k8s-node1"
    vm.vm.network "private_network", ip: "192.168.56.12"
    vm.vm.provider "virtualbox" do |vb|
      vb.linked_clone = true
      # worker: calico + kubelet run comfortably in 3 GB.
      vb.memory = 3072
      vb.cpus = 2
    end
  end
end
